  "biomes": [
    { "id": "mourning-fen", "name": "MOURNING FEN", "subtitle": "The reeds clean water nobody can afford.", "description": "East of Vesper, reed beds and black pools filter the city's runoff. Pump families live on wages paid by the concession draining their drinking water. A slower pump means fewer poisoned nests and fewer paid shifts.", "center": [1440, 0, 320], "radius": 240, "minLevel": 8, "color": "#86b9a0", "ground": "#233e35", "kind": "wetland", "seed": 4181 },
    { "id": "cinderwood", "name": "CINDERWOOD", "subtitle": "A standing tree pays less than a dead one.", "description": "West of the furnaces, charred trunks shelter the last living canopy. A restoration fund pays cutters by the stump and counts its plantations before they germinate. The workers know; their children still need heat.", "center": [-1440, 0, -320], "radius": 240, "minLevel": 18, "color": "#b99b75", "ground": "#383930", "kind": "forest", "seed": 4182 },
    { "id": "glassroot-steppe", "name": "GLASSROOT STEPPE", "subtitle": "The grass grows through the survey stakes.", "description": "North of the city, silver grasses root in the mineral seam used to fire Lattice bodies. Mining buys another person's continuity by removing the soil that holds a settlement together. The wind recognizes neither deed nor refuge.", "center": [0, 0, -1440], "radius": 240, "minLevel": 30, "color": "#bcc6aa", "ground": "#41463b", "kind": "grassland", "seed": 4183 },
    { "id": "brine-bloom", "name": "BRINE BLOOM", "subtitle": "Life returns without promising to include us.", "description": "South of the floodgate, fungal fans spread over the abandoned salt pans. The growth is alive, invasive, and indifferent. Licensed cultures and feral descendants drink from the same dwindling seep; neither can be persuaded to leave enough.", "center": [400, 0, 1600], "radius": 240, "minLevel": 30, "color": "#9ab5b6", "ground": "#303d43", "kind": "fungal", "seed": 4184 }
  ],

    { "id": "market", "name": "AFTERLIGHT COMMONS", "subtitle": "Every meal comes from somewhere that cannot invoice us.", "center": [0, 0, 0], "radius": 180, "minLevel": 0, "color": "#c4ed92" },
    { "id": "archive", "name": "THE GLASS ARCHIVE", "subtitle": "The forest is gone. Its valuation survives.", "center": [320, 0, -320], "radius": 220, "minLevel": 10, "color": "#c9a2ec" },
